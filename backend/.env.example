# PentaProtocol backend environment template.
# Copy to .env (gitignored) and fill in real values. Never commit this
# file with secrets.

# ── Core ─────────────────────────────────────────────────────────────
# 32+ bytes of random hex. Generate with: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=replace_with_strong_random_secret
# JWT lifetime. 10080 = 7 days. Short-lived tokens are safer; we rotate
# via the per-user "sid" mechanism on login anyway.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Datastores ──────────────────────────────────────────────────────
# Mongo (Atlas). Use a scoped user that only has read/write on the one
# database, never the admin role.
MONGO_URI=
DATABASE_NAME=pentaprotocol
# Redis (for rate limits, OTP, 2FA pending, reset codes, abuse counters).
REDIS_URL=redis://localhost:6379/0

# ── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@pentaprotocol.com

# ── Security alerting (Phase 2.8) ───────────────────────────────────
# Comma-separated recipient list for alert-severity security events.
# Leave empty to disable (alerts still log via Python logging).
ALERT_EMAILS=
# Optional override of the sender address; defaults to FROM_EMAIL.
ALERT_FROM_EMAIL=
# Dedup window: each (event_type, severity, user_bucket, ip_bucket)
# tuple sends at most one email per N seconds. Default 600.
ALERT_THROTTLE_SECONDS=600
# Hard cap on emails per event_type per hour, regardless of dedup.
# Prevents a pathological bug from spamming ops into muting us.
ALERT_MAX_PER_HOUR=6
# FEATURE_ALERTING=0 to kill the entire alert path (logs still work).

# ── Payments ─────────────────────────────────────────────────────────
# The only supported payment path is the operator-verified UPI / bank-QR
# flow (see /api/store/upi-submit). No gateway credentials are required;
# users submit a bank UTR and ops credits manually.

# ── URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# BACKEND_URL is the public origin. Must be HTTPS in production.
BACKEND_URL=http://localhost:8000

# ── Google Sign-In (server-side verification) ───────────────────────
GOOGLE_CLIENT_ID=

# ── Optional legacy OTP SMTP service ────────────────────────────────
OTP_GMAIL_USER=
OTP_GMAIL_APP_PASSWORD=

# ── Proxy image safety settings ─────────────────────────────────────
PROXY_IMAGE_ALLOWED_HOSTS=images.unsplash.com,cdn.discordapp.com,i.imgur.com
PROXY_IMAGE_MAX_BYTES=5242880

# ── Admin / staff (Phase 2.7) ───────────────────────────────────────
# Bootstrap allowlist for /api/admin. Comma-separated user ObjectIds.
# Needed only until at least one user has users.role="admin" in the
# DB; after that, rotate this env var empty. A caller listed here is
# always treated as admin regardless of their users.role value.
ADMIN_USER_IDS=

# ── Edge / real client IP (Phase 3) ─────────────────────────────────
# Comma-separated CIDRs of proxies we trust to forward client IP.
# Leave blank to use the built-in Cloudflare + Railway defaults.
# Set this explicitly if you EVER switch off Cloudflare, otherwise
# the app will trust spoofed X-Forwarded-For headers from attackers.
# TRUSTED_PROXY_CIDRS=

# ── Feature flags (defaults safe if unset) ──────────────────────────
# See app/core/flags.py for the full list and semantics.
# FEATURE_ANTICHEAT=1
# FEATURE_ANTICHEAT_HEURISTICS=1
# FEATURE_ABUSE_DETECT=1
# FEATURE_LEGAL_GATE=1
# FEATURE_SECURITY_AUDIT=1
# FEATURE_ALERTING=1
# FEATURE_ECONOMY_WATCH=1
# LIMIT_WS_FRAMES_PER_10S=30
