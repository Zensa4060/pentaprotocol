# Argus personal assistant environment template.
# Copy to .env and fill in real values.

# GitHub personal access token (repo scope for private repos).
GITHUB_TOKEN=

# Groq API key for Mythos brain.
GROQ_API_KEY=

# PentaProtocol backend base URL (stats fetched from /api/argus/stats).
PENTAPROTOCOL_API_URL=https://pentaprotocol-production.up.railway.app

# Shared secret for PentaProtocol stats API (X-Argus-Key header).
ARGUS_API_KEY=

# NewsAPI key for headline integration (newsapi.org).
NEWS_API_KEY=

# OpenWeatherMap API key (openweathermap.org).
WEATHER_API_KEY=

# Default city for weather lookups.
DEFAULT_CITY=Delhi
