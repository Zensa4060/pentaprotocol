# Copy to ``.env`` or set via ``eas.json`` for production builds.
# Anything prefixed with ``EXPO_PUBLIC_`` is inlined into the JS bundle
# at build time and IS visible to anyone who unpacks the app — so do
# NOT put secrets here (those go in EAS Secrets / Railway env).

# FastAPI backend origin (no trailing slash). MUST be https:// in production
# and on physical Android devices (cleartext http:// is blocked → ERR_NETWORK).
#
# Production (Railway direct — works from mobile without Cloudflare):
#   EXPO_PUBLIC_API_URL=https://pentaprotocol-production.up.railway.app
# Public API (behind Cloudflare — use once mobile User-Agent is allowed):
#   EXPO_PUBLIC_API_URL=https://api.pentaprotocol.com
#
# Local dev:
#   - iOS Simulator:              http://localhost:8000
#   - Android Emulator:           http://10.0.2.2:8000
#   - Physical phone + local API: http://<your-LAN-IP>:8000
#
# Local Android emulator (default dev):
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Production:
# EXPO_PUBLIC_API_URL=https://pentaprotocol-production.up.railway.app

# Web OAuth 2.0 Client ID from Google Cloud Console — used by the
# native Google Sign-In library to mint the ID token the backend
# verifies. Create one of type "Web application" in
# https://console.cloud.google.com/apis/credentials and paste its
# client ID here. (You do NOT need its secret on the client.)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client ID (type "Android" in Google Cloud — NOT the Web client).
# Register EAS SHA-1 on this credential (npm run android:sha1). Also set in eas.json for EAS builds.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=